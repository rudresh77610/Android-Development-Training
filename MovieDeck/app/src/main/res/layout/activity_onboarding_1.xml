<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:contentDescription="Reel logo"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/logo"
            android:text="Reel"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:text="Skip"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="60dp"
            android:contentDescription="Star"
            android:src="@drawable/ic_star" />

        <FrameLayout
            android:layout_width="300dp"
            android:layout_height="230dp"
            android:layout_gravity="center">

            <TextView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_marginStart="-70dp"
                android:background="@drawable/gradient_blue"
                android:gravity="bottom|start"
                android:padding="12dp"
                android:rotation="-12"
                android:text="Dune"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_marginStart="70dp"
                android:background="@drawable/gradient_dark"
                android:gravity="bottom|start"
                android:padding="12dp"
                android:rotation="12"
                android:text=""
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="150dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:layout_marginStart="0dp"
                android:background="@drawable/gradient_orange"
                android:gravity="bottom|start"
                android:padding="12dp"
                android:rotation="0"
                android:text="Oppenheimer"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/step"
        style="@style/Reel.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01 / 03"
        android:textColor="@color/blue" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Every story, one app."
        android:textColor="@color/ink"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.15"
        android:minLines="3"
        android:text="Discover movies, shows, and people in a catalog that spans blockbusters, indie gems, and what's trending tonight."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <View
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_active" />
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_inactive" />
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_inactive" />
        </LinearLayout>

        <ImageView
            android:id="@+id/next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_circle_blue"
            android:contentDescription="Next"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_forward" />
    </RelativeLayout>
</LinearLayout>
